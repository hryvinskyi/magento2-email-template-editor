    <!--
        Variable Knowledge: what the merchant-defined and template-declared variables are read from.

        The custom-variable index and the template's own declarations are each read once per request
        and shared by everyone who needs them - the chooser an author picks a variable from and the
        descriptions shown for the directives already in the content - because a single description
        request asks about hundreds of directives and a load per question turns one query into
        hundreds.

        The describe context carries the template being described to the one source that cannot
        answer without it. It is request-scoped mutable state: whoever sets it clears it in a
        finally, or a template identifier left behind answers the next description confidently about
        the wrong template.
    -->
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\TemplateVariableDeclarationsInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\TemplateVariableDeclarations"/>
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Knowledge\CustomVariableIndexInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\CustomVariableIndex"/>
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Knowledge\DescribeContextInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\DescribeContext"/>

    <!--
        Variable Knowledge: entries and the registry that answers with them.

        EditAffordanceInterface has no preference on purpose: its implementation is reachable only
        through named constructors, each of which refuses an affordance that would render as a
        control doing nothing, so it is never built by the object manager.
    -->
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Data\Knowledge\OriginInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\Data\Origin"/>
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Data\Knowledge\ResolvedValueInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\Data\ResolvedValue"/>
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Data\Knowledge\VariableKnowledgeInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\Data\VariableKnowledge"/>
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Knowledge\VariableKnowledgeRegistryInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\VariableKnowledgeRegistry"/>
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Data\Knowledge\ModifierDescriptorInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\Data\ModifierDescriptor"/>
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Knowledge\ModifierRegistryInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\ModifierRegistry"/>

    <!--
        Variable Knowledge: the single decision about whether a store configuration value may be
        written from the editor.

        It is a service rather than a private method because the question is asked in two places far
        apart - once when an entry is built, to decide whether an inline editor is offered, and again
        when a write arrives, because the browser's answer is never trusted. Two copies of that
        predicate would drift, and the copy that drifts is the one nobody is watching.

        WritabilityVerdictInterface has no preference on purpose: its implementation is reachable
        only through named constructors, one of which refuses a refusal that carries no reason, so it
        is never built by the object manager.
    -->
    <preference for="Hryvinskyi\EmailTemplateEditor\Api\Knowledge\ConfigPathWritabilityInterface"
                type="Hryvinskyi\EmailTemplateEditor\Model\Knowledge\ConfigPathWritability"/>

